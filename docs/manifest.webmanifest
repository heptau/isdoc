{
	"name": "ISDOC Viewer",
	"short_name": "ISDOC",
	"description": "View ISDOC and ISDOCX invoices, check the signature and pay by QR code.",
	"lang": "en",
	"id": "./",
	"start_url": "./index.html",
	"scope": "./",
	"display": "standalone",
	"background_color": "#f3f5f8",
	"theme_color": "#1f4e8c",
	"icons": [
		{
			"src": "icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icons/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml"
		}
	],
	"file_handlers": [
		{
			"action": "./index.html",
			"accept": {
				"application/vnd.isdoc+xml": [
					".isdoc"
				],
				"application/vnd.isdocx+zip": [
					".isdocx"
				]
			},
			"icons": [
				{
					"src": "icons/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				},
				{
					"src": "icons/icon-512.png",
					"sizes": "512x512",
					"type": "image/png"
				}
			],
			"launch_type": "single-client"
		}
	],
	"launch_handler": {
		"client_mode": [
			"focus-existing",
			"auto"
		]
	}
}
